{
  "name": "quiz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HYPERFRAMES_NO_TELEMETRY=1 HYPERFRAMES_NO_UPDATE_CHECK=1 npx --yes --prefer-offline hyperframes@0.8.115 preview",
    "check": "HYPERFRAMES_NO_TELEMETRY=1 HYPERFRAMES_NO_UPDATE_CHECK=1 npx --yes --prefer-offline hyperframes@0.8.115 check",
    "render": "HYPERFRAMES_NO_TELEMETRY=1 HYPERFRAMES_NO_UPDATE_CHECK=1 npx --yes --prefer-offline hyperframes@0.8.115 render -o out/quiz.mp4",
    "publish": "npx --yes hyperframes@0.8.115 publish"
  },
  "devDependencies": {
    "hyperframes": "0.8.115"
  }
}
