[
 {
  "start": 0.699,
  "end": 1.689,
  "text": "Context engineering is"
 },
 {
  "start": 1.749,
  "end": 2.3,
  "text": "just giving your"
 },
 {
  "start": 2.36,
  "end": 2.98,
  "text": "agent a map."
 },
 {
  "start": 3.4,
  "end": 4.1,
  "text": "Humans search when"
 },
 {
  "start": 4.16,
  "end": 4.41,
  "text": "they know what"
 },
 {
  "start": 4.47,
  "end": 5.06,
  "text": "they're looking for"
 },
 {
  "start": 5.28,
  "end": 5.56,
  "text": "but we turn"
 },
 {
  "start": 5.62,
  "end": 6.02,
  "text": "to agents"
 },
 {
  "start": 6.02,
  "end": 6.26,
  "text": "when we're not"
 },
 {
  "start": 6.32,
  "end": 6.78,
  "text": "really sure what"
 },
 {
  "start": 6.84,
  "end": 7.12,
  "text": "we need"
 },
 {
  "start": 7.18,
  "end": 7.44,
  "text": "so they end"
 },
 {
  "start": 7.5,
  "end": 8.34,
  "text": "up exploring more."
 },
 {
  "start": 8.84,
  "end": 9.5,
  "text": "The obvious fix"
 },
 {
  "start": 9.56,
  "end": 9.76,
  "text": "is to"
 },
 {
  "start": 9.82,
  "end": 10.36,
  "text": "stuff everything"
 },
 {
  "start": 10.59,
  "end": 11.16,
  "text": "into the context"
 },
 {
  "start": 11.22,
  "end": 11.5,
  "text": "window, but"
 },
 {
  "start": 11.56,
  "end": 12.26,
  "text": "that'll backfire."
 },
 {
  "start": 12.76,
  "end": 13.2,
  "text": "The model doesn't"
 },
 {
  "start": 13.26,
  "end": 13.74,
  "text": "really find what"
 },
 {
  "start": 13.8,
  "end": 14.38,
  "text": "you're looking for."
 },
 {
  "start": 14.86,
  "end": 15.12,
  "text": "This is known"
 },
 {
  "start": 15.18,
  "end": 15.94,
  "text": "as context rot."
 },
 {
  "start": 16.72,
  "end": 17.82,
  "text": "Having one giant"
 },
 {
  "start": 17.88,
  "end": 18.88,
  "text": "AGENTS.md file does"
 },
 {
  "start": 18.94,
  "end": 19.46,
  "text": "not work."
 },
 {
  "start": 19.68,
  "end": 20.0,
  "text": "When everything"
 },
 {
  "start": 20.06,
  "end": 20.62,
  "text": "is important"
 },
 {
  "start": 20.78,
  "end": 21.22,
  "text": "nothing is. It"
 },
 {
  "start": 21.28,
  "end": 21.78,
  "text": "can't cut through"
 },
 {
  "start": 21.84,
  "end": 22.22,
  "text": "the noise"
 },
 {
  "start": 22.28,
  "end": 22.68,
  "text": "to find what"
 },
 {
  "start": 22.74,
  "end": 23.34,
  "text": "really matters."
 },
 {
  "start": 24.0,
  "end": 24.4,
  "text": "But by creating"
 },
 {
  "start": 24.46,
  "end": 25.22,
  "text": "a simple map"
 },
 {
  "start": 25.32,
  "end": 25.66,
  "text": "a map in"
 },
 {
  "start": 25.72,
  "end": 26.46,
  "text": "Markdown or an"
 },
 {
  "start": 26.52,
  "end": 26.88,
  "text": "index in"
 },
 {
  "start": 26.94,
  "end": 27.34,
  "text": "a database"
 },
 {
  "start": 28.08,
  "end": 28.76,
  "text": "you hold pointers"
 },
 {
  "start": 28.82,
  "end": 29.6,
  "text": "to files."
 },
 {
  "start": 30.11,
  "end": 31.18,
  "text": "You concisely let"
 },
 {
  "start": 31.24,
  "end": 32.559,
  "text": "the agent navigate"
 },
 {
  "start": 32.619,
  "end": 33.02,
  "text": "where it needs"
 },
 {
  "start": 33.08,
  "end": 33.36,
  "text": "to go."
 },
 {
  "start": 33.49,
  "end": 34.06,
  "text": "The agent reads"
 },
 {
  "start": 34.12,
  "end": 34.4,
  "text": "the map and"
 },
 {
  "start": 34.46,
  "end": 35.14,
  "text": "drills into only"
 },
 {
  "start": 35.2,
  "end": 35.72,
  "text": "what it needs"
 },
 {
  "start": 35.84,
  "end": 36.56,
  "text": "to, retrieving"
 },
 {
  "start": 36.62,
  "end": 37.1,
  "text": "that part."
 }
]