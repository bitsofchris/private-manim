 },
 {
  "start": 13.82,
  "end": 14.69,
  "text": "sums them, adds"
 },
 {
  "start": 14.75,
  "end": 15.402,
  "text": "a bias, and"
 },
 {
  "start": 15.463,
  "end": 16.55,
  "text": "outputs one number."
 },
 {
  "start": 16.55,
  "end": 17.664,
  "text": "Two outputs, two"
 },
 {
  "start": 17.724,
  "end": 18.904,
  "text": "neurons, two rows"
 },
 {
  "start": 18.964,
  "end": 19.62,
  "text": "of three."
 },
 {
  "start": 19.62,
  "end": 20.825,
  "text": "In the forward"
 },
 {
  "start": 20.885,
  "end": 22.491,
  "text": "pass, PyTorch flips"
 },
 {
  "start": 22.551,
  "end": 23.11,
  "text": "it: x @ weight.T"
 },
 {
  "start": 23.17,
  "end": 24.78,
  "text": "plus a bias."
 },
 {
  "start": 24.78,
  "end": 25.646,
  "text": "The flipped weight"
 },
 {
  "start": 25.706,
  "end": 26.116,
  "text": "is three"
 },
 {
  "start": 26.176,
  "end": 26.54,
  "text": "by two"
 },
 {
  "start": 26.54,
  "end": 27.484,
  "text": "exactly the W"
 },
 {
  "start": 27.544,
  "end": 28.151,
  "text": "from the"
 },
 {
  "start": 28.211,
  "end": 29.02,
  "text": "last video"
 },
 {
  "start": 29.02,
  "end": 29.908,
  "text": "where each row"
 },
 {
  "start": 29.968,
  "end": 30.678,
  "text": "is where an"
 },
 {
  "start": 30.738,
  "end": 32.1,
  "text": "input direction lands."
 },
 {
  "start": 32.1,
  "end": 32.481,
  "text": "So don't ask"
 },
 {
  "start": 32.541,
  "end": 32.893,
  "text": "which is in"
 },
 {
  "start": 32.953,
  "end": 33.246,
  "text": "and which"
 },
 {
  "start": 33.306,
  "end": 33.54,
  "text": "is out"
 },
 {
  "start": 33.54,
  "end": 34.38,
  "text": "ask where are"
 },
 {
  "start": 34.44,
  "end": 35.16,
  "text": "the landing"
 },
 {
  "start": 35.22,
  "end": 36.18,
  "text": "vectors stored"
 },
 {
  "start": 36.18,
  "end": 37.033,
  "text": "in the rows"
 },
 {
  "start": 37.093,
  "end": 38.23,
  "text": "or the columns."
 },
 {
  "start": 38.23,
  "end": 39.186,
  "text": "In math, vectors"
 },
 {
  "start": 39.246,
  "end": 40.146,
  "text": "are columns and"
 },
 {
  "start": 40.206,
  "end": 40.768,
  "text": "W times v"
 },
 {
  "start": 40.828,
  "end": 41.84,
  "text": "uses the columns."
 },
 {
  "start": 41.84,
  "end": 43.348,
  "text": "In PyTorch, vectors"
 },
 {
  "start": 43.408,
  "end": 44.388,
  "text": "are rows and"
 },
 {
  "start": 44.448,
  "end": 45.126,
  "text": "x @ W uses"
 },
 {
  "start": 45.186,
  "end": 45.94,
  "text": "the rows."
 },
 {
  "start": 45.94,
  "end": 46.675,
  "text": "It's the same"
 },
 {
  "start": 46.735,
  "end": 47.89,
  "text": "idea just transposed."
 },
 {
  "start": 47.89,
  "end": 49.481,
  "text": "nn.Linear stores neurons"
 },
 {
  "start": 49.541,
  "end": 50.05,
  "text": "as rows"
 },
 {
  "start": 50.05,
  "end": 50.96,
  "text": "and transposes on"
 },
 {
  "start": 51.02,
  "end": 51.88,
  "text": "the way through."
 }
