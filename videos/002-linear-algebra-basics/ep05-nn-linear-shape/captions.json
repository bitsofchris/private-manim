[
 {
  "start": 0.67,
  "end": 2.036,
  "text": "PyTorch stores one"
 },
 {
  "start": 2.096,
  "end": 3.103,
  "text": "output neuron"
 },
 {
  "start": 3.163,
  "end": 3.6,
  "text": "per row."
 },
 {
  "start": 4.81,
  "end": 5.731,
  "text": "So when you"
 },
 {
  "start": 5.791,
  "end": 7.173,
  "text": "give nn.Linear 3 in"
 },
 {
  "start": 7.232,
  "end": 8.0,
  "text": "and 2 out,"
 },
 {
  "start": 8.0,
  "end": 8.792,
  "text": "the weight will"
 },
 {
  "start": 8.852,
  "end": 9.545,
  "text": "come back two"
 },
 {
  "start": 9.605,
  "end": 10.1,
  "text": "by three."
 },
 {
  "start": 10.1,
  "end": 10.982,
  "text": "A neuron takes"
 },
 {
  "start": 11.042,
  "end": 12.1,
  "text": "all three inputs"
 },
 {
  "start": 12.1,
  "end": 13.001,
  "text": "multiplies each by"
 },
 {
  "start": 13.061,
  "end": 13.82,
