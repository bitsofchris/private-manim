[
 {
  "start": 0.45,
  "end": 0.9,
  "text": "You can change"
 },
 {
  "start": 0.96,
  "end": 1.64,
  "text": "what your classifier"
 },
 {
  "start": 1.7,
  "end": 2.12,
  "text": "does without"
 },
 {
  "start": 2.18,
  "end": 2.78,
  "text": "retraining it."
 },
 {
  "start": 3.18,
  "end": 3.67,
  "text": "It's a prompt"
 },
 {
  "start": 3.73,
  "end": 4.62,
  "text": "injection detector."
 },
 {
  "start": 5.07,
  "end": 5.56,
  "text": "You just move"
 },
 {
  "start": 5.62,
  "end": 6.2,
  "text": "this line."
 },
 {
  "start": 6.74,
  "end": 7.4,
  "text": "An ROC curve"
 },
 {
  "start": 7.46,
  "end": 8.74,
  "text": "shows every place"
 },
 {
  "start": 8.8,
  "end": 9.06,
  "text": "that you could"
 },
 {
  "start": 9.12,
  "end": 9.44,
  "text": "put it."
 },
 {
  "start": 9.84,
  "end": 10.24,
  "text": "The model doesn't"
 },
 {
  "start": 10.3,
  "end": 10.84,
  "text": "say yes or no."
 },
 {
  "start": 10.88,
  "end": 11.1,
  "text": "It gives"
 },
 {
  "start": 11.16,
  "end": 11.7,
  "text": "every request"
 },
 {
  "start": 11.76,
  "end": 12.3,
  "text": "a score."
 },
 {
  "start": 12.9,
  "end": 13.66,
  "text": "And this threshold"
 },
 {
  "start": 13.72,
  "end": 14.3,
  "text": "is what turns"
 },
 {
  "start": 14.36,
  "end": 14.86,
  "text": "that score into"
 },
 {
  "start": 14.92,
  "end": 15.36,
  "text": "a yes."
 },
 {
  "start": 15.9,
  "end": 16.28,
  "text": "You slide it"
 },
 {
  "start": 16.34,
  "end": 16.68,
  "text": "to the left"
 },
 {
  "start": 16.74,
  "end": 16.94,
  "text": "and we can"
 },
 {
  "start": 17.0,
  "end": 17.8,
  "text": "catch every attack."
 },
 {
  "start": 18.32,
  "end": 18.65,
  "text": "But we end up"
 },
 {
  "start": 18.71,
  "end": 19.3,
  "text": "blocking most"
 },
 {
  "start": 19.36,
  "end": 19.86,
  "text": "of our users."
 },
 {
  "start": 20.42,
  "end": 20.92,
  "text": "If you slide it"
 },
 {
  "start": 20.98,
  "end": 21.46,
  "text": "to the right,"
 },
 {
  "start": 21.52,
  "end": 22.04,
  "text": "almost nobody"
 },
 {
  "start": 22.1,
  "end": 22.66,
  "text": "gets blocked"
 },
 {
  "start": 22.74,
  "end": 23.18,
  "text": "but half of"
 },
 {
  "start": 23.24,
  "end": 23.64,
  "text": "the attacks"
 },
 {
  "start": 23.7,
  "end": 24.1,
  "text": "get through."
 },
 {
  "start": 24.6,
  "end": 25.6,
  "text": "Every threshold gives"
 },
 {
  "start": 25.66,
  "end": 25.99,
  "text": "a new"
 },
 {
  "start": 26.05,
  "end": 26.74,
  "text": "confusion matrix"
 },
 {
  "start": 26.85,
  "end": 27.48,
  "text": "and each one"
 },
 {
  "start": 27.54,
  "end": 28.14,
  "text": "is a point."
 },
 {
  "start": 28.6,
  "end": 29.26,
  "text": "The true positive"
 },
 {
  "start": 29.32,
  "end": 30.2,
  "text": "rate up,"
 },
 {
  "start": 30.34,
  "end": 31.1,
  "text": "false positive rate"
 },
 {
  "start": 31.16,
  "end": 32.24,
  "text": "across."
 },
 {
  "start": 32.3,
  "end": 32.68,
  "text": "Top left is"
 },
 {
  "start": 32.74,
  "end": 34.08,
  "text": "the sweet spot."
 },
 {
  "start": 34.14,
  "end": 34.58,
  "text": "Now ROC"
 },
 {
  "start": 34.64,
  "end": 34.88,
  "text": "is for"
 },
 {
  "start": 35.0,
  "end": 35.94,
  "text": "picking thresholds."
 },
 {
  "start": 36.0,
  "end": 36.72,
  "text": "You decide whether"
 },
 {
  "start": 36.78,
  "end": 37.48,
  "text": "you'd rather"
 },
 {
  "start": 37.54,
  "end": 38.84,
  "text": "avoid false positives"
 },
 {
  "start": 38.9,
  "end": 39.3,
  "text": "or get all"
 },
 {
  "start": 39.36,
  "end": 39.74,
  "text": "the positives"
 },
 {
  "start": 39.78,
  "end": 40.3,
  "text": "depending on"
 },
 {
  "start": 40.36,
  "end": 40.72,
  "text": "the problem"
 },
 {
  "start": 40.78,
  "end": 41.3,
  "text": "you're solving."
 }
